#!/bin/bash
rm -f ~/Pictures/Space*
ARGS=$@

rotate_bg() {
  UNIQUE_ID=`echo $RANDOM | md5sum | head -c 10`
  TMP_DIR="/tmp/bg_$UNIQUE_ID"
  mkdir -p $TMP_DIR
  
  HOME=$TMP_DIR ~/.local/bin/space_backgrounds --display-driver wayland -s ~/.local/libexec/space_backgrounds.gd --width $1 --height $2 $ARGS ${@:4}
  
  mv $TMP_DIR/Space*.png ~/Pictures/$3.png
  rm -rf $TMP_DIR
  sleep 0.5
}

rotate_bg 2560 1440 bg_big 
rotate_bg 1920 1080 bg_small 
rotate_bg 1920 1080 bg_headless --theme 13 

wait
swaymsg reload

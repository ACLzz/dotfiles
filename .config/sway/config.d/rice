# Border style
default_border pixel 1
default_floating_border normal

# Colors
set $cl_high #60592a
set $cl_indi #d9d8d8
set $cl_back #231f20
set $cl_fore #d9d8d8
set $cl_urge #ee2e24

# Windows style
client.focused          $cl_high $cl_high $cl_fore $cl_indi $cl_high
client.focused_inactive $cl_back $cl_back $cl_fore $cl_back $cl_back
client.unfocused        $cl_back $cl_back $cl_fore $cl_back $cl_back
client.urgent           $cl_urge $cl_urge $cl_fore $cl_urge $cl_urge

# Font
font pango:Monocraft 11

# Themes
## gtk theme
set $gtk_theme Adwaita-dark
## cursor theme
set $cursor_theme Bibata-Original-Ice
set $cursor_size 24
seat seat0 xcursor_theme $cursor_theme $cursor_size

output eDP-1 bg '~/Pictures/bg_small.png' fill
output HDMI-A-1 bg '~/Pictures/bg_big.png' fill
output HEADLESS-1 bg '~/Pictures/bg_headless.png' fill

exec rotate_bg --stars true --dust true --planets true --darken true --theme 7
